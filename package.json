{
  "name": "gomep-vacantes-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run dev -w gomep-vacantes",
    "test": "npm test -w gomep-vacantes",
    "scrape": "npm run scrape -w gomep-vacantes-scrapper",
    "test:scrapper": "npm test -w gomep-vacantes-scrapper",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-gomep-vacantes \"npm test -w gomep-vacantes-scrapper\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-gomep-vacantes"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "firebase-tools": "^14.0.0"
  }
}
