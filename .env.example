# Target URL to monitor
TARGET_URL=https://apps.mep.go.cr/formulario

# Optional: CSS selector to extract specific content (e.g. .mud-table-container)
# Leave empty to use entire body
CONTENT_SELECTOR=".mud-table-container"

# Optional: Use a real browser (Playwright) when the page needs JS or a dropdown to load data
# Set to 1 or true to enable. Requires: npm install (playwright is already a dependency)
USE_PLAYWRIGHT=1
HEADLESS=1

# When USE_PLAYWRIGHT=1, optional dropdown to select before capturing content
# DROPDOWN_SELECTOR = CSS selector for the dropdown (e.g. #regionalSelect)
# DROPDOWN_OPTION_VALUE = option value to select (native <select>)
# DROPDOWN_OPTION_LABEL = option label to select (text of the option)
# DROPDOWN_WAIT_AFTER_MS = ms to wait after selecting (default 2000)
# DROPDOWN_CUSTOM = 1 for MudBlazor / custom dropdowns (click to open, then click option)
DROPDOWN_SELECTOR="#regionalSelect"
DROPDOWN_CUSTOM=1
DROPDOWN_OPTION_VALUE=53
DROPDOWN_OPTION_LABEL="Regional Educación Perez Zeledon"
DROPDOWN_WAIT_AFTER_MS=2000

# Column names (data-label) used to parse each vacancy row
TABLE_CELL_NAMES="Vacante,Especialidad,Clase de Puesto,Institución,Lecciones"
TABLE_FILTER_ESPECIALIDAD="Especialidad"
TABLE_FILTER_PUESTO="Clase de Puesto"
TABLE_FILTER_INSTITUCION="Institución"
TABLE_FILTER_LECCIONES="Lecciones"

# Filter values (exact match). Especialidad accepts a comma-separated list.
# Leave a *_VALUE empty to skip that filter.
TABLE_FILTER_ESPECIALIDAD_VALUE="Español"
# TABLE_FILTER_ESPECIALIDAD_VALUE="Español,Inglés"
# TABLE_FILTER_PUESTO_VALUE="Profesor de Enseñanza Media"
# TABLE_FILTER_INSTITUCION_VALUE="Liceo Pérez Zeledón"
# TABLE_FILTER_LECCIONES_VALUE="32"

# Path for the last-seen vacancy list (default: ./data/baseline.json)
# BASELINE_PATH=./data/baseline.json

# Notification: choose one or both

## ntfy.sh - No signup required. Use a unique topic name (e.g., vacantes-mep-perez)
## Subscribe at https://ntfy.sh/your-topic to receive push notifications
NTFY_TOPIC=your-unique-topic

## Telegram - Create bot with @BotFather, get token, then get your chat ID
## Send a message to your bot, then visit: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
