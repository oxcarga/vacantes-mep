# --- Página a vigilar -------------------------------------------------------
TARGET_URL=https://apps.mep.go.cr/formulario
CONTENT_SELECTOR=".mud-table-container"
USE_PLAYWRIGHT=1
HEADLESS=1
# PLAYWRIGHT_LAUNCH_ARGS=--disable-dev-shm-usage,--no-sandbox

# --- Regional ---------------------------------------------------------------
DROPDOWN_SELECTOR="#regionalSelect"
DROPDOWN_WAIT_AFTER_MS=2000
MAX_PAGES=30
SCRAPE_ATTEMPTS=3
SCRAPE_RETRY_DELAY_MS=5000

# --- Columnas y filtros -----------------------------------------------------
TABLE_CELL_NAMES="Vacante,Especialidad,Clase de Puesto,Institución,Lecciones"
TABLE_IDENTITY_CELL_NAMES="Vacante,Especialidad,Institución"
TABLE_FILTER_ESPECIALIDAD="Especialidad"
TABLE_FILTER_PUESTO="Clase de Puesto"
TABLE_FILTER_INSTITUCION="Institución"
TABLE_FILTER_LECCIONES="Lecciones"
# TABLE_FILTER_ESPECIALIDAD_VALUE="Español"
# ALLOW_EMPTY_TABLE=0

# --- Estado -----------------------------------------------------------------
# Local sin GCP: archivo JSON.
BASELINE_PATH=data/baseline.json

# Producción (Cloud Run) y emulador: Firestore.
# En Cloud Run GOOGLE_CLOUD_PROJECT viene inyectado.
# FIRESTORE_PROJECT_ID=su-proyecto-gcp
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# --- Correo (Resend). Sin estas claves el scrape registra el correo y sigue. ---
# RESEND_API_KEY=
# MAIL_FROM=GoMEP Vacantes <alertas@example.com>
# APP_URL=https://su-app.web.app
