# --- Página a vigilar -------------------------------------------------------
TARGET_URL=https://apps.mep.go.cr/formulario

# Selector de la tabla de vacantes. Deje "body" para usar la página completa.
CONTENT_SELECTOR=".mud-table-container"

# El formulario del MEP es una app Blazor: sin navegador la tabla no existe.
USE_PLAYWRIGHT=1
HEADLESS=1

# Argumentos extra para Chromium (necesarios dentro de contenedores).
# PLAYWRIGHT_LAUNCH_ARGS=--disable-dev-shm-usage,--no-sandbox

# --- Regional ---------------------------------------------------------------
# El MEP usa un <select> nativo, así que basta con el value o la etiqueta.
# DROPDOWN_CUSTOM=1 sólo aplica a listas que no son <select> (MudBlazor, MUI).
DROPDOWN_SELECTOR="#regionalSelect"
DROPDOWN_OPTION_VALUE=53
DROPDOWN_OPTION_LABEL="Regional Educación Perez Zeledon"
DROPDOWN_WAIT_AFTER_MS=2000
DROPDOWN_CUSTOM=1
# DROPDOWN_OPTION_SELECTOR=".mud-list-item, [role='option'], .mud-select-item"

# Máximo de páginas del paginador que se recorren en cada consulta.
MAX_PAGES=30

# El sitio del MEP se cae a ratos: se reintenta antes de dar la consulta por
# fallida, con una espera creciente entre intentos.
SCRAPE_ATTEMPTS=3
SCRAPE_RETRY_DELAY_MS=5000

# --- Columnas y filtros -----------------------------------------------------
# Columnas (data-label) que se leen de cada fila.
TABLE_CELL_NAMES="Vacante,Especialidad,Clase de Puesto,Institución,Lecciones"

# Columnas que identifican una vacante. Si cambia cualquier otra columna la
# vacante se reporta como modificada en vez de como una baja más un alta.
TABLE_IDENTITY_CELL_NAMES="Vacante,Especialidad,Institución"

# Nombre de la columna por la que se filtra...
TABLE_FILTER_ESPECIALIDAD="Especialidad"
TABLE_FILTER_PUESTO="Clase de Puesto"
TABLE_FILTER_INSTITUCION="Institución"
TABLE_FILTER_LECCIONES="Lecciones"

# ...y el valor (o valores separados por coma) que debe tener. Deje vacío
# un *_VALUE para no aplicar ese filtro.
TABLE_FILTER_ESPECIALIDAD_VALUE="Español"
# TABLE_FILTER_ESPECIALIDAD_VALUE="Español,Inglés"
# TABLE_FILTER_PUESTO_VALUE="Profesor de Enseñanza Media"
# TABLE_FILTER_INSTITUCION_VALUE="Liceo Pérez Zeledón"
# TABLE_FILTER_LECCIONES_VALUE="32"

# Por seguridad, una tabla vacía no reemplaza el estado guardado. Póngalo en 1
# si la regional puede quedarse legítimamente sin vacantes.
# ALLOW_EMPTY_TABLE=0

# --- Estado entre consultas -------------------------------------------------
# Por defecto se guarda un archivo JSON con la última lista vista.
BASELINE_PATH=data/baseline.json

# Opcional: base SQLite/Turso con el histórico completo (alta, baja, cambios).
# Local o volumen de Docker:
# DATABASE_URL=file:data/vacantes.db
# Turso, para que el estado sobreviva a los runners efímeros de GitHub Actions:
# DATABASE_URL=libsql://SU-BASE.turso.io
# DATABASE_AUTH_TOKEN=

# --- Notificaciones (configure al menos una) --------------------------------
## ntfy.sh — sin registro. Use un tema único y difícil de adivinar y
## suscríbase en https://ntfy.sh/su-tema
NTFY_TOPIC=su-tema-privado

## Telegram — cree el bot con @BotFather y obtenga su chat ID en
## https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
